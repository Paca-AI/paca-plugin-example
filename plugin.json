{
  "id": "com.paca.example",
  "displayName": "Plugin SDK Hello World",
  "description": "Hello world examples for every Paca plugin SDK feature.",
  "version": "0.1.2",
  "minCoreVersion": "v0.13.3",
  "permissions": ["db.read", "db.write", "events.subscribe", "events.emit"],
  "customPermissions": [
    {
      "key": "example.manage",
      "label": "Manage Hello settings",
      "description": "View this project's Hello Project Settings tab. Demonstrates a plugin-specific custom permission gating a project.settings.tab registration — does not affect the sidebar/task-detail/view Hello surfaces, which stay visible to any project member on purpose (the backend read routes they share with this settings tab are intentionally left ungated for that reason). Creating, editing, or deleting a Hello message from any of those surfaces still requires the built-in projects.write (Owner/Manager-tier), same as this settings tab's own write actions — an ordinary member can view but not write, on every surface alike.",
      "scope": "project"
    }
  ],
  "backend": {
    "eventSubscriptions": ["task.deleted"],
    "routes": [
      {
        "method": "GET",
        "path": "/projects/:projectId/hello",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "POST",
        "path": "/projects/:projectId/hello",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "PATCH",
        "path": "/projects/:projectId/hello/:id",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/hello/:id",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/hello/plain",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "GET",
        "path": "/projects/:projectId/hello/stats",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.read"]
          }
        ]
      },
      {
        "method": "DELETE",
        "path": "/projects/:projectId/hello/stats/cache",
        "middlewares": [
          { "name": "optionalAuthn" },
          { "name": "requireFreshPassword" },
          {
            "name": "requirePermissions",
            "scope": "project",
            "permissions": ["projects.write"]
          }
        ]
      }
    ]
  },
  "frontend": {
    "remoteEntryUrl": "/plugins/com.paca.example/assets/remoteEntry.js",
    "extensionPoints": [
      {
        "point": "sidebar.general.section",
        "component": "HelloGeneralSection",
        "order": 10
      },
      {
        "point": "sidebar.project.section",
        "component": "HelloProjectSection",
        "order": 10
      },
      {
        "point": "task.detail.section",
        "component": "HelloTaskSection",
        "order": 10
      },
      {
        "point": "project.settings.tab",
        "component": "HelloProjectSettingsTab",
        "order": 10,
        "requiredPermission": "example.manage"
      },
      {
        "point": "view",
        "component": "HelloView",
        "order": 10
      }
    ]
  },
  "mcp": {
    "remoteEntryUrl": "/plugins-mcp/com.paca.example/mcp.js"
  },
  "skills": {
    "baseUrl": "/plugins-skills/com.paca.example",
    "names": ["paca-hello-greeting"]
  }
}
